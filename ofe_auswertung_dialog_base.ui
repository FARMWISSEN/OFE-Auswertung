     <property name="html">
      <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:1; text-indent:0px; line-height:138%; background-color:transparent;&quot;&gt;&lt;a name=&quot;docs-internal-guid-cbbfc80a-7fff-073a-0de8-208cc65265d3&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; font-weight:704; color:#1f1f1f;&quot;&gt;i&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; font-weight:704; color:#1f1f1f;&quot;&gt;tem / vars&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; color:#1f1f1f;&quot;&gt;: Die Nummer der Variablen.&lt;/span&gt;&lt;/p&gt;
&lt;ul style=&quot;margin-top: 0px; margin-bottom: 0px; margin-left: 0px; margin-right: 0px; -qt-list-indent: 1;&quot;&gt;&lt;li style=&quot; font-family:'Courier New'; font-size:8pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-weight:704; color:#1f1f1f;&quot;&gt;n&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; color:#1f1f1f;&quot;&gt;: Die Anzahl der gültigen Werte (Stichprobengröße pro Gruppe).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Courier New'; font-size:8pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-weight:704; color:#1f1f1f;&quot;&gt;mean&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; color:#1f1f1f;&quot;&gt;: Der Mittelwert (arithmetisches Mittel).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Courier New'; font-size:8pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-weight:704; color:#1f1f1f;&quot;&gt;sd&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; color:#1f1f1f;&quot;&gt;: Die Standardabweichung (Streuung der Werte).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Courier New'; font-size:8pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-weight:704; color:#1f1f1f;&quot;&gt;median&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; color:#1f1f1f;&quot;&gt;: Der Median (der genau mittlere Wert).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Courier New'; font-size:8pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-weight:704; color:#1f1f1f;&quot;&gt;trimmed&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; color:#1f1f1f;&quot;&gt;: Das getrimmte Mittel (Standard: die äußeren 10% der Werte werden ignoriert, um Ausreißer abzufedern).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Courier New'; font-size:8pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-weight:704; color:#1f1f1f;&quot;&gt;mad&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; color:#1f1f1f;&quot;&gt;: Die mittlere absolute Abweichung (ein robusteres Streuungsmaß als die Standardabweichung).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Courier New'; font-size:8pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-weight:704; color:#1f1f1f;&quot;&gt;min / max&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; color:#1f1f1f;&quot;&gt;: Der kleinste und größte Wert.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Courier New'; font-size:8pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-weight:704; color:#1f1f1f;&quot;&gt;range&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; color:#1f1f1f;&quot;&gt;: Die Spannweite (max minus min).&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Courier New'; font-size:8pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-weight:704; color:#1f1f1f;&quot;&gt;skew / kurtosis&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; color:#1f1f1f;&quot;&gt;: zwischen -1 und +1 sind die Daten annähernd normalverteilt.&lt;/span&gt;&lt;/li&gt;
&lt;li style=&quot; font-family:'Courier New'; font-size:8pt; color:#000000; background-color:transparent;&quot; style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-weight:704; color:#1f1f1f;&quot;&gt;se&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; color:#1f1f1f;&quot;&gt;: Der Standardfehler des Mittelwerts.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/body&gt;&lt;/html&gt;</string>
