&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:8.25pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;a name=&quot;docs-internal-guid-862f6399-7fff-acab-b4c3-e9026a3006b6&quot;&gt;&lt;/a&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; color:#1f1f1f; background-color:transparent;&quot;&gt;T&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; color:#1f1f1f; background-color:transparent;&quot;&gt;eilen sich zwei Gruppen mindestens &lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; font-weight:600; color:#1f1f1f; background-color:transparent;&quot;&gt;einen gemeinsamen Buchstaben&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; color:#1f1f1f; background-color:transparent;&quot;&gt;, gibt es zwischen ihnen &lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; font-weight:600; color:#1f1f1f; background-color:transparent;&quot;&gt;keinen&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; color:#1f1f1f; background-color:transparent;&quot;&gt; statistisch signifikanten Unterschied.&lt;/span&gt;&lt;/p&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px; line-height:138%;&quot;&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; color:#1f1f1f; background-color:transparent;&quot;&gt;Haben zwei Gruppen&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; font-weight:600; color:#1f1f1f; background-color:transparent;&quot;&gt; komplett unterschiedliche Buchstaben&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; color:#1f1f1f; background-color:transparent;&quot;&gt;,&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; font-weight:600; color:#1f1f1f; background-color:transparent;&quot;&gt; ist der Unterschied statistisch abgesicher&lt;/span&gt;&lt;span style=&quot; font-family:'Google Sans','sans-serif'; font-size:8pt; color:#1f1f1f; background-color:transparent;&quot;&gt;t.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
